# --- URLs: FRONTEND_URL/BACKEND_URL son para desarrollo local (localhost) y también
# se usan como fallback en producción si no seteás las *_PUBLIC_URL. En Vercel, cada
# proyecto (Backend/Frontend) tiene sus PROPIAS env vars — no se comparten entre sí.
# FRONTEND_PUBLIC_URL/BACKEND_PUBLIC_URL deben apuntar siempre al dominio ESTABLE de
# producción (Settings → Domains en Vercel), nunca a una URL de un deployment puntual
# (esas cambian/expiran). Sin esto bien seteado, Payway no puede redirigir al usuario
# ni mandar el webhook — ya pasó en producción, revisar ambas antes de cada deploy.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PORT=3001
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
BACKEND_PUBLIC_URL=https://tu-backend.vercel.app
FRONTEND_PUBLIC_URL=https://tu-frontend.vercel.app

# --- Payway ---
PAYWAY_ENVIRONMENT=developer
PAYWAY_PUBLIC_KEY=
PAYWAY_PRIVATE_KEY=
PAYWAY_MERCHANT_ID=Farmacia Apotheka
PAYWAY_DEVELOPER=apotheka-dev
PAYWAY_SITE_ID=
PAYWAY_TEMPLATE_ID=1
# Secreto propio (no lo provee Payway) para validar que las notificaciones a
# /api/pagos/notificacion realmente vengan del checkout que nosotros creamos.
PAYWAY_WEBHOOK_SECRET=

# --- WhatsApp (Cloud API de Meta) ---
# Notifica por WhatsApp al admin cada vez que se crea un pedido nuevo.
# Si WHATSAPP_TOKEN está vacío, el servicio corre en modo stub (solo loguea en consola,
# no llama a la API real) — no hace falta configurarlo para desarrollo local.
# WHATSAPP_TOKEN: token PERMANENTE del System User (Meta Business Settings → Usuarios del
#   sistema → Generar token, permisos whatsapp_business_messaging + whatsapp_business_management).
#   El token temporal de 24hs que da el panel de pruebas NO sirve acá, se vence.
WHATSAPP_TOKEN=
# Phone Number ID del número remitente (developers.facebook.com → tu app → WhatsApp →
# Configuración de la API). Mientras no hagas el "Paso 2: Configuración de producción",
# es el número de prueba gratuito que asigna Meta — funciona indefinidamente para un
# solo destinatario fijo, no hace falta pasar a un número real.
WHATSAPP_PHONE_NUMBER_ID=
# Número que recibe el aviso, en formato internacional SIN el '+' (ej: 5493518354942).
WHATSAPP_ADMIN_NUMBER=
# Nombre e idioma de la plantilla aprobada en WhatsApp Manager. La plantilla debe tener
# el body con 2 variables CON NOMBRE (numero_pedido, total_pedido), ej:
# "🔔 Nuevo pedido en Apotheka #{{numero_pedido}} — Total: ${{total_pedido}}. Revisalo en el panel de administración."
WHATSAPP_TEMPLATE_NAME=nuevo_pedido_admin
WHATSAPP_TEMPLATE_LANG=es_AR

# --- Correo Argentino (MiCorreo) ---
# Si CORREO_AR_USUARIO está vacío, el servicio corre en modo stub (datos simulados).
CORREO_AR_USUARIO=
CORREO_AR_PASSWORD=
CORREO_AR_BASE_URL=https://apitest.correoargentino.com.ar/micorreo/v1
CORREO_AR_CUSTOMER_ID=
CORREO_AR_POSTAL_CODE_ORIGIN=
CORREO_AR_SENDER_NAME=Farmacia Apotheka
CORREO_AR_SENDER_PHONE=
CORREO_AR_SENDER_CELLPHONE=
CORREO_AR_SENDER_EMAIL=
CORREO_AR_SENDER_STREET_NAME=
CORREO_AR_SENDER_STREET_NUMBER=
CORREO_AR_SENDER_FLOOR=
CORREO_AR_SENDER_APARTMENT=
CORREO_AR_SENDER_CITY=
CORREO_AR_SENDER_PROVINCE_CODE=
CORREO_AR_SENDER_POSTAL_CODE=

# --- ARCA / AfipSDK (facturación electrónica) ---
# Si ARCA_CUIT o ARCA_ACCESS_TOKEN están vacíos, no se emiten facturas (modo stub).
# ARCA_ACCESS_TOKEN se obtiene creando una cuenta en https://afipsdk.com (todas las
# llamadas del SDK pasan por su API, incluso en homologación).
ARCA_CUIT=
ARCA_ACCESS_TOKEN=
ARCA_PUNTO_VENTA=1
# Cert/key del certificado autorizado en ARCA (WSASS) para el servicio wsfe.
# Completar SOLO uno de los dos pares por variable:
#   - ARCA_CERT / ARCA_KEY: contenido PEM completo (incluye líneas BEGIN/END), tal cual
#     se usa en Vercel (no hay filesystem persistente para leer un archivo ahí).
#   - ARCA_CERT_PATH / ARCA_KEY_PATH: ruta local a los archivos .crt/.key, solo para
#     desarrollo. Si ARCA_CERT/ARCA_KEY tienen contenido, tienen prioridad sobre la ruta.
ARCA_CERT=
ARCA_KEY=
ARCA_CERT_PATH=
ARCA_KEY_PATH=
ARCA_PRODUCCION=false

# --- ARCA / AfipSDK — AMBIENTE DE PRODUCCIÓN (CUIDADO: credenciales reales) ---
# Completamente separado de las variables de arriba (homologación). Ver TEST_AFIP_PRODUCCION.md
# antes de tocar esto: cualquier emisión con estas credenciales tiene validez fiscal real.
# ARCA_ENVIRONMENT=produccion es el interruptor maestro: sin esto en "produccion" exacto,
# el cliente de producción no se inicializa aunque las demás variables estén completas.
ARCA_ENVIRONMENT=homologacion
ARCA_PROD_CUIT=
# ARCA_ACCESS_TOKEN (el de arriba) se reutiliza tal cual para producción, no hace falta uno nuevo.
# ARCA_PROD_CERT / ARCA_PROD_KEY: Base64 del .crt/.key completos (no el PEM crudo), pensado
# para pegar en Vercel sin riesgo de que se corten saltos de línea. Ver TEST_AFIP_PRODUCCION.md
# para el comando que genera el Base64.
ARCA_PROD_CERT=
ARCA_PROD_KEY=
# Alternativa solo para desarrollo local: ruta a los archivos, con el PEM crudo (no Base64).
ARCA_PROD_CERT_PATH=
ARCA_PROD_KEY_PATH=

# Datos fijos del negocio para el PDF de la factura (completar con los datos reales)
ARCA_RAZON_SOCIAL=
ARCA_DOMICILIO_FISCAL=
ARCA_CONDICION_IVA=Responsable Inscripto
ARCA_INGRESOS_BRUTOS=
ARCA_INICIO_ACTIVIDADES=
