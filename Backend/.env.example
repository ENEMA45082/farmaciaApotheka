# --- ARCA / AfipSDK (facturación electrónica) ---
# Si ARCA_CUIT o ARCA_ACCESS_TOKEN están vacíos, no se emiten facturas (modo stub).
# ARCA_CERT/ARCA_KEY/ARCA_PRODUCCION quedan vacíos hasta tramitar el certificado real de producción.
ARCA_CUIT=
ARCA_ACCESS_TOKEN=
ARCA_PUNTO_VENTA=1
ARCA_CERT=
ARCA_KEY=
ARCA_PRODUCCION=false

